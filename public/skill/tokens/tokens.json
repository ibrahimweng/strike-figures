{
  "$description": "Strike design tokens (W3C Design Tokens format). The single source for CSS, Tailwind and Figma. Dark is the default theme.",
  "color": {
    "$type": "color",
    "ground": { "$value": "#0C0C0C", "$description": "Ground: posters, social cards, illustrations, app modules", "$extensions": { "app.strikelabs": { "name": "Ground", "rgbPercent": "5, 5, 5", "cmyk": "0, 0, 0, 95" } } },
    "web": {
      "ground": { "$value": "#090B0A", "$description": "Website and marketing page background (about 80%)" },
      "section": { "$value": "#0F1110", "$description": "Website alternate sections and cards (about 20%), for depth and separation" }
    },
    "ink": { "$value": "#F9F9F9", "$description": "White: text on ground; ground of light layouts", "$extensions": { "app.strikelabs": { "name": "White", "rgbPercent": "98, 98, 98", "cmyk": "0, 0, 0, 2" } } },
    "ink-2": { "$value": "#B3B3B3", "$description": "Secondary text on dark (9.3:1)" },
    "ink-3": { "$value": "#8A8F98", "$description": "Muted text and icons on dark (6.0:1)" },
    "green": { "$value": "#10B981", "$description": "Strike Green: primary action, focus, one highlight. Never fills a layout; no white text on it in UI", "$extensions": { "app.strikelabs": { "name": "Strike Green", "rgbPercent": "6, 73, 51", "cmyk": "91, 0, 30, 27" } } },
    "deep": { "$value": "#047857", "$description": "Mark Deep: green text or lines on light grounds (5.2:1)", "$extensions": { "app.strikelabs": { "name": "Mark Deep", "rgbPercent": "2, 47, 34", "cmyk": "97, 0, 28, 53" } } },
    "mark-light": { "$value": "#6EE7B7", "$description": "Mark Light: the light end of the logo gradient", "$extensions": { "app.strikelabs": { "name": "Mark Light", "rgbPercent": "43, 91, 72", "cmyk": "52, 0, 21, 9" } } },
    "profit": { "$value": "#3FD4AB", "$description": "Profit: market moves up (gains, buys, bids)", "$extensions": { "app.strikelabs": { "name": "Profit", "rgbPercent": "25, 83, 67", "cmyk": "70, 0, 19, 17" } } },
    "loss": { "$value": "#EE5E74", "$description": "Loss: market moves down (losses, sells, asks). Red means loss and nothing else", "$extensions": { "app.strikelabs": { "name": "Loss", "rgbPercent": "93, 37, 45", "cmyk": "0, 61, 51, 7" } } },
    "mint": { "$value": "#50EBA0", "$description": "Poster grounds and the light end of the poster gradient" },
    "data": {
      "yellow": { "$value": "#FFEF3C", "$description": "Chart data series only", "$extensions": { "app.strikelabs": { "name": "Yellow", "rgbPercent": "100, 94, 24", "cmyk": "3, 0, 86, 0" } } },
      "sky": { "$value": "#0788F7", "$description": "Chart data series only", "$extensions": { "app.strikelabs": { "name": "Sky", "rgbPercent": "3, 53, 97", "cmyk": "74, 45, 0, 0" } } },
      "purple": { "$value": "#976FE6", "$description": "Chart data series only", "$extensions": { "app.strikelabs": { "name": "Purple", "rgbPercent": "59, 44, 90", "cmyk": "53, 65, 0, 0" } } }
    },
    "dark": {
      "frame": { "$value": "#2E2E2E", "$description": "App frame: the lighter background that shows only in the thin gaps between modules" },
      "surface-1": { "$value": "#161616", "$description": "Raised controls on a module: inputs, tabs, secondary buttons" },
      "surface-2": { "$value": "#202020", "$description": "Hover and selected" },
      "surface-3": { "$value": "#2A2A2A", "$description": "Pressed; the strongest raise" },
      "line": { "$value": "#FFFFFF1A", "$description": "Hairlines (10%)" },
      "line-strong": { "$value": "#FFFFFF2E", "$description": "Input borders and dividers (18%)" }
    },
    "light": {
      "ground": { "$value": "#F9F9F9" },
      "surface-1": { "$value": "#FFFFFF" },
      "surface-2": { "$value": "#F1F1F1" },
      "surface-3": { "$value": "#E8E8E9" },
      "ink": { "$value": "#0C0C0C" },
      "ink-2": { "$value": "#4A4D52", "$description": "8.1:1 on light ground" },
      "ink-3": { "$value": "#6B6F76", "$description": "4.8:1 on light ground" },
      "line": { "$value": "#0C0C0C14" },
      "line-strong": { "$value": "#0C0C0C24" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Geist", "Arial", "sans-serif"], "$description": "Geist for everything; Arial when web fonts are unavailable" },
      "mono": { "$value": ["Geist Mono", "ui-monospace", "monospace"], "$description": "Code, wallet addresses, order books only" },
      "display-pixel": { "$value": ["Geist Pixel Circle", "Geist", "sans-serif"], "$description": "Large display type and numbers on posters only, where contrast is high; never body text or company documents" },
      "wordmark": { "$value": ["Ciburial"], "$description": "The STRIKE wordmark only; use the logo files" }
    },
    "weight": {
      "$type": "fontWeight",
      "light": {
        "$value": 300
      },
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": "72px",
        "lineHeight": 1.0,
        "letterSpacing": "-0.02em"
      }
    },
    "h1": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": "48px",
        "lineHeight": 1.0,
        "letterSpacing": "-0.02em"
      }
    },
    "h2": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": "32px",
        "lineHeight": 1.2,
        "letterSpacing": "-0.01em"
      }
    },
    "h3": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": "24px",
        "lineHeight": 1.3,
        "letterSpacing": "0"
      }
    },
    "body-l": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 400,
        "fontSize": "18px",
        "lineHeight": 1.3,
        "letterSpacing": "0"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 400,
        "fontSize": "16px",
        "lineHeight": 1.3,
        "letterSpacing": "0"
      }
    },
    "small": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 400,
        "fontSize": "14px",
        "lineHeight": 1.35,
        "letterSpacing": "0.01em"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": "12px",
        "lineHeight": 1.35,
        "letterSpacing": "0.01em"
      }
    },
    "$description": "Line height and tracking follow the brand book chart by size: up to 14 px 1.35 / +1%, 15-24 px 1.3 / 0, 25-44 px 1.2 / -1%, 45-79 px 1.0 / -2%, 80 px and up 0.9 / -3%",
    "slide-h1": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": "120px",
        "lineHeight": 0.9,
        "letterSpacing": "-0.03em"
      },
      "$description": "Slides and posters at 1920 x 1080 (brand book 2.3)"
    },
    "slide-h2": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": "72px",
        "lineHeight": 1.0,
        "letterSpacing": "-0.02em"
      },
      "$description": "Slides and posters at 1920 x 1080 (brand book 2.3)"
    },
    "slide-h3": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": "42px",
        "lineHeight": 1.2,
        "letterSpacing": "-0.01em"
      },
      "$description": "Slides and posters at 1920 x 1080 (brand book 2.3)"
    },
    "slide-body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 400,
        "fontSize": "18px",
        "lineHeight": 1.3,
        "letterSpacing": "0"
      },
      "$description": "Slides and posters at 1920 x 1080 (brand book 2.3)"
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" },
    "8": { "$value": "64px" },
    "9": { "$value": "96px" },
    "10": { "$value": "128px" },
    "grid": { "$value": "50px", "$description": "Posters, cards, illustrations" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px", "$description": "Small controls" },
    "md": { "$value": "8px", "$description": "Buttons, inputs" },
    "lg": { "$value": "12px", "$description": "Cards" },
    "pill": { "$value": "9999px" }
  },
  "size": {
    "$type": "dimension",
    "control": { "$value": "40px" },
    "control-sm": { "$value": "32px" },
    "logo-mark-min": { "$value": "16px", "$description": "Flat mark on screen" },
    "logo-3d-min": { "$value": "32px", "$description": "3D mark on screen; under it, use the flat mark" },
    "logo-lockup-min-height": { "$value": "20px", "$description": "Lockup height" },
    "logo-max-share": { "$value": "33.333%", "$description": "The logo is never wider than one third of the layout" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" },
      "gather": { "$value": "400ms", "$description": "Shapes speeding into the rest cluster" },
      "release": { "$value": "320ms", "$description": "Shapes easing out of it to the new state; hover-in" },
      "rest": { "$value": "280ms", "$description": "Still between moves" },
      "loop": { "$value": "1000ms", "$description": "One loop: rest + gather + release" },
      "press-in": { "$value": "240ms", "$description": "Click: squeeze in" },
      "press-out": { "$value": "200ms", "$description": "Click: back out" }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1], "$description": "Plain UI: hover, color, panels" },
      "gather": { "$value": [0.55, 0, 0.85, 0], "$description": "Ease in: shapes speed up into the moment they meet" },
      "release": { "$value": [0.15, 1, 0.6, 1], "$description": "Ease out: fast away from it, then a long quiet settle" }
    }
  }
}
