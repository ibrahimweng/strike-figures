{
  "$description": "Strike design tokens (W3C Design Tokens format). The single source for CSS, Tailwind and Figma. Dark is the default theme.",
  "color": {
    "$type": "color",
    "ground": { "$value": "#0C0C0C", "$description": "The dark background: posters, social cards, illustrations, app modules" },
    "web": {
      "ground": { "$value": "#090B0A", "$description": "Website and marketing page background (about 80%)" },
      "section": { "$value": "#0F1110", "$description": "Website alternate sections and cards (about 20%), for depth and separation" }
    },
    "ink": { "$value": "#F9F9F9", "$description": "Text on ground; ground of light layouts" },
    "ink-2": { "$value": "#B3B3B3", "$description": "Secondary text on dark (9.3:1)" },
    "ink-3": { "$value": "#8A8F98", "$description": "Muted text and icons on dark (6.0:1)" },
    "green": { "$value": "#10B981", "$description": "Primary action, focus, one highlight" },
    "deep": { "$value": "#047857", "$description": "Green text or lines on light grounds (5.2:1)" },
    "mark-light": { "$value": "#6EE7B7", "$description": "Logo gradient only" },
    "profit": { "$value": "#3FD4AB", "$description": "Gains, buys, bids" },
    "loss": { "$value": "#EE5E74", "$description": "Losses, sells, asks. Red means loss and nothing else" },
    "mint": { "$value": "#50EBA0", "$description": "Poster grounds only" },
    "data": {
      "yellow": { "$value": "#FFEF3C", "$description": "Charts with several series only" },
      "sky": { "$value": "#0788F7", "$description": "Charts with several series only" },
      "purple": { "$value": "#976FE6", "$description": "Charts with several series only" }
    },
    "dark": {
      "frame": { "$value": "#2E2E2E", "$description": "App frame: the lighter background that shows only in the thin gaps between modules" },
      "surface-1": { "$value": "#161616", "$description": "Raised controls on a module: inputs, tabs, secondary buttons" },
      "surface-2": { "$value": "#202020", "$description": "Hover and selected" },
      "surface-3": { "$value": "#2A2A2A", "$description": "Pressed; the strongest raise" },
      "line": { "$value": "#FFFFFF1A", "$description": "Hairlines (10%)" },
      "line-strong": { "$value": "#FFFFFF2E", "$description": "Input borders and dividers (18%)" }
    },
    "light": {
      "ground": { "$value": "#F9F9F9" },
      "surface-1": { "$value": "#FFFFFF" },
      "surface-2": { "$value": "#F1F1F1" },
      "surface-3": { "$value": "#E8E8E9" },
      "ink": { "$value": "#0C0C0C" },
      "ink-2": { "$value": "#4A4D52", "$description": "8.1:1 on light ground" },
      "ink-3": { "$value": "#6B6F76", "$description": "4.8:1 on light ground" },
      "line": { "$value": "#0C0C0C14" },
      "line-strong": { "$value": "#0C0C0C24" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Geist",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "Geist Mono",
          "ui-monospace",
          "monospace"
        ],
        "$description": "Code, wallet addresses, order books only"
      },
      "display-pixel": {
        "$value": [
          "Geist Pixel Circle",
          "Geist",
          "sans-serif"
        ],
        "$description": "Big display numbers on posters only"
      },
      "wordmark": {
        "$value": [
          "Ciburial"
        ],
        "$description": "The STRIKE wordmark only; use the logo files"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "light": {
        "$value": 300
      },
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": "72px",
        "lineHeight": 0.95,
        "letterSpacing": "-0.03em"
      }
    },
    "h1": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": "48px",
        "lineHeight": 1.0,
        "letterSpacing": "-0.03em"
      }
    },
    "h2": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": "32px",
        "lineHeight": 1.1,
        "letterSpacing": "-0.02em"
      }
    },
    "h3": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": "24px",
        "lineHeight": 1.2,
        "letterSpacing": "-0.015em"
      }
    },
    "body-l": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 400,
        "fontSize": "18px",
        "lineHeight": 1.5,
        "letterSpacing": "0"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 400,
        "fontSize": "16px",
        "lineHeight": 1.5,
        "letterSpacing": "0"
      }
    },
    "small": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 400,
        "fontSize": "14px",
        "lineHeight": 1.45,
        "letterSpacing": "0"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": 500,
        "fontSize": "12px",
        "lineHeight": 1.4,
        "letterSpacing": "0.02em"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" },
    "8": { "$value": "64px" },
    "9": { "$value": "96px" },
    "10": { "$value": "128px" },
    "grid": { "$value": "50px", "$description": "Posters, cards, illustrations" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px", "$description": "Small controls" },
    "md": { "$value": "8px", "$description": "Buttons, inputs" },
    "lg": { "$value": "12px", "$description": "Cards" },
    "pill": { "$value": "9999px" }
  },
  "size": {
    "$type": "dimension",
    "control": { "$value": "40px" },
    "control-sm": { "$value": "32px" },
    "logo-mark-min": { "$value": "16px" },
    "logo-lockup-min-height": { "$value": "20px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
  }
}
