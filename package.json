{
  "name": "strike-figures",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Figures: Strike's illustration tool. Line-art figures, flat or 3D, animated; export SVG, PNG, MP4, GIF, animated SVG and Lottie; make X thread posts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "render": "vite-node scripts/render-presets.ts --",
    "glyphs": "node scripts/build-glyphs.mjs",
    "skill:build": "node skill/scripts/build.mjs --out ../public/skill",
    "skill:check": "node skill/scripts/check.mjs",
    "skill:test": "npm --prefix skill test",
    "skill:lockup": "node skill/scripts/lockup.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "gifenc": "1.0.3",
    "mp4-muxer": "5.2.2",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "webm-muxer": "5.1.4",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "opentype.js": "1.3.4",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
