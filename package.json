{
  "name": "strike-figures",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Figures: a 3D line-art illustration tool in Linear's isometric style, for Strike. Rotate, paint dotted fills, export SVG and PNG.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "render": "vite-node scripts/render-presets.ts --"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
